# =============================================================================
#  English Reading 环境配置模板
#  复制本文件为 `.env`，再按“备注说明”逐项修改。
#  具体设置项、邮箱服务商取值、授权码等说明见各段注释。
# =============================================================================


# -----------------------------------------------------------------------------
# [邮件发送] Nodemailer / SMTP —— 用于发送注册验证码邮件
#   SMTP_HOST 留空则不真发信，验证码打印到服务器日志（开发模式）。
# -----------------------------------------------------------------------------

# ① SMTP 服务器地址：QQ -> smtp.qq.com / 163 -> smtp.163.com / Gmail -> smtp.gmail.com
# SMTP_HOST=

# ② SMTP 端口：通常 465(SSL) 或 587(STARTTLS)
# SMTP_PORT=465

# ③ 发信邮箱完整地址，如 youremail@qq.com
# SMTP_USER=

# ④ SMTP 密码/授权码（QQ/163/126 填授权码，不是登录密码）
# SMTP_PASS=

# ⑤ 发件人显示地址，留空则用 SMTP_USER
# SMTP_FROM=



# -----------------------------------------------------------------------------
# [Redis] 验证码与会话存储。连不上会自动降级为内存（仅开发）。
# -----------------------------------------------------------------------------

# ⑥ 本地 Redis 默认：redis://127.0.0.1:6379；带密码示例：redis://:pass@host:6379
REDIS_URL=redis://127.0.0.1:6379


# -----------------------------------------------------------------------------
# [服务] HTTP 端口
# -----------------------------------------------------------------------------

# ⑦ 监听端口，默认 3000
PORT=3000
