# =============================================================================
#  EngNote 环境配置模板
#  复制本文件为 `.env`，再按“备注说明”逐项修改。
#  具体设置项、邮箱服务商取值、授权码等说明见各段注释。
# =============================================================================


# -----------------------------------------------------------------------------
# [邮件发送] Nodemailer / SMTP —— 用于发送注册验证码邮件
#   SMTP_HOST 留空且非生产模式时不真发信，返回本地开发验证码。
#   生产模式必须正确配置 SMTP；发信失败不会返回验证码。
# -----------------------------------------------------------------------------

# ① SMTP 服务器地址：QQ -> smtp.qq.com / 163 -> smtp.163.com / Gmail -> smtp.gmail.com
# SMTP_HOST=

# ② SMTP 端口：通常 465(SSL) 或 587(STARTTLS)
# SMTP_PORT=465

# ③ 发信邮箱完整地址，如 youremail@qq.com
# SMTP_USER=

# ④ SMTP 密码/授权码（QQ/163/126 填授权码，不是登录密码）
# SMTP_PASS=

# ⑤ 发件人显示地址，留空则用 SMTP_USER
# SMTP_FROM=
# 发件人显示名称（可选）
# SMTP_FROM_NAME=EngNote



# -----------------------------------------------------------------------------
# [Redis] 验证码与会话存储。连不上仅在开发模式降级为内存，重启后需重新登录。
# 留空 REDIS_URL= 可明确禁用 Redis（仅开发）；生产模式必须有可用 Redis。
# -----------------------------------------------------------------------------

# ⑥ 本地 Redis 默认：redis://127.0.0.1:6379；带密码示例：redis://:pass@host:6379
REDIS_URL=redis://127.0.0.1:6379


# -----------------------------------------------------------------------------
# [服务] HTTP 端口
# -----------------------------------------------------------------------------

# ⑦ 服务监听端口，默认 3000。
PORT=3000

# 默认允许局域网访问；如需仅本机访问，改为 127.0.0.1。
HOST=0.0.0.0

# 数据库路径；留空使用项目根目录 data.db（不影响现有数据）。
# DB_PATH=/absolute/path/to/data.db

# HTTPS 反向代理部署时设为 true，使会话 Cookie 仅通过 HTTPS 传输。
# COOKIE_SECURE=true

# HTTPS 反向代理的公开源地址，写请求 Origin 必须与此一致（无路径）。
# APP_ORIGIN=https://reading.example.com
