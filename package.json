{
  "name": "english_reading",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --watch index.ts",
    "start": "NODE_ENV=production bun index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "test": "bun test ./tests",
    "build": "bun build ./public/home.html ./public/index.html --target browser --outdir dist --minify",
    "seed": "bun seed.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "nodemailer": "^9.0.5",
    "redis": "^6.2.1"
  }
}
